# Provider preset: groq (default) | ollama | openrouter | scripted (offline policy, no LLM)
# The web app runs the scripted policy when the chosen provider has no API key.
LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides (take precedence over the preset)
# LLM_BASE_URL=
# LLM_MODEL=            # groq default openai/gpt-oss-120b; alternative qwen/qwen3.8-27b
# LLM_API_KEY=

# Fall back to local Ollama if the primary provider is unreachable
LLM_FALLBACK=ollama

# Web app: seconds between watcher ticks (provider cancellations, UNVERIFIED rechecks, expiry)
# WATCH_INTERVAL_S=3
